---
import { BASE_DIR, NAV_LINKS, SITE_TITLE } from "../config.ts";
import ThemeToggle from "./ThemeToggle.astro";
---

<header id="main-header" class="w-full py-4 px-4 md:px-8 transition-transform duration-300" role="banner" transition:persist>
	<nav class="max-w-5xl mx-auto flex justify-between items-center">
		<a href={BASE_DIR} id="logo" class="text-2xl font-bold text-primary-600 dark:text-primary-400" data-astro-reload>{SITE_TITLE}</a>
		<div class="hidden md:flex items-center space-x-6">
			{
				NAV_LINKS.map((link) => (
					<a href={link.href} class:list={["text-lg font-medium text-slate-700 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors", { "font-bold text-primary-600 dark:text-primary-400": Astro.url.pathname === link.href }]} aria-current={Astro.url.pathname === link.href ? "page" : false}>
						{link.text}
					</a>
				))
			}
			<ThemeToggle />
		</div>
	</nav>
</header>
