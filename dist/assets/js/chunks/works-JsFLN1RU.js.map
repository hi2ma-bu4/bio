---
import { Picture } from "astro:assets";

import ArrowTopRightOnSquareIcon from "astro-heroicons/solid/ArrowTopRightOnSquare.astro";
import GitHub from "./icon/GitHub.astro";
import { getImageWidths, isImageMetadata, type Work } from "../types/work-item";

export type Props = Work;

const { id, title, description, imageUrl, tags, directLink, githubLink } = Astro.props;

const isCardFooter = directLink || githubLink;
---

<div id={`work-card-${id}`} class="flex flex-col justify-between flex-nowrap group rounded-lg overflow-hidden shadow-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
	<button class="work-modal-trigger w-full h-full flex flex-col text-left" data-work-id={id} aria-haspopup="dialog">
		<div class="aspect-video overflow-hidden">
			{
				isImageMetadata(imageUrl) ? (
					<Picture src={imageUrl} widths={getImageWidths(imageUrl)} formats={["avif", "webp"]} alt={`${title}のスクリーンショット`} fetchpriority="low" pictureAttributes={{ class: "w-full h-full" }} class="object-cover transition-transform duration-300 group-hover:scale-105" />
				) : (
					<img src={imageUrl} alt={`${title}のスクリーンショット`} loading="lazy" decoding="async" fetchpriority="low" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
				)
			}
		</div>

		<div class="p-4 md:p-6 pb-2 md:pb-2">
			<h3 class="text-xl font-bold mb-2 text-slate-900 dark:text-white">{title}</h3>
			<p class="text-slate-600 dark:text-slate-400 text-sm mb-4 line-clamp-2">{description}</p>

			<div class="flex flex-wrap gap-2">
				{tags.map((tag) => <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200">{tag}</span>)}
			</div>
		</div>
	</button>

	{
		isCardFooter && (
			<div class="p-4 md:p-6 pt-0 md:pt-0 flex flex-row gap-2">
				{directLink && (
					<a href={directLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-md text-sm font-medium bg-primary-600 text-white hover:bg-primary-700 focus-visible:ring-primary-500 transition-colors" onclick="event.stopPropagation()" aria-label={`${title}のサイトへ移動`}>
						サイトへ移動
						<ArrowTopRightOnSquareIcon class="w-4 h-4" />
					</a>
				)}
				{githubLink && (
					<a href={githubLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-md text-sm font-medium bg-gray-800 text-white hover:bg-gray-900 dark:text-gray-900 dark:bg-gray-400 dark:hover:bg-gray-300 focus-visible:ring-primary-500 transition-colors" onclick="event.stopPropagation()" aria-label={`${title}のGitHubへ移動`}>
						<GitHub class="w-5 h-5" />
					</a>
				)}
			</div>
		)
	}
</div>
