---
import LinkCard from "../components/LinkCard.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Link" description="JavaScript を中心に、個人開発したページ・スクリプトを掲載しています。関連リンク集。">
	<h1 class="text-4xl md:text-5xl font-extrabold mb-10 text-center">Link</h1>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		<LinkCard href="https://github.com/hi2ma-bu4/" title="GitHub" description="コード置き場" iconName="GitHub" />
		<LinkCard href="https://gist.github.com/hi2ma-bu4/" title="GitHub Gist" description="コード部品を放棄する場所" iconName="GitHubGist" />
		<LinkCard href="https://greasyfork.org/ja/users/1245323" title="Greasyfork" description="Tampermonkey用ユーザースクリプト公開場所" iconName="Greasyfork" />
		<LinkCard href="https://github.com/hi2ma-bu4/bio" title="bio" description="このサイトのリポジトリ" iconName="Bio" />
	</div>
</Layout>
