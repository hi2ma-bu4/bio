---
import HomeIcon from "astro-heroicons/solid/Home.astro";
import { BASE_DIR } from "../config";
import ErrorLayout from "../layouts/ErrorLayout.astro";
---

<ErrorLayout title="404 Not Found" description="お探しのページは見つかりませんでした。">
	<section class="text-center py-20">
		<h1 class="text-6xl md:text-8xl font-extrabold mb-8">
			<span class="text-transparent bg-clip-text bg-linear-to-r from-red-500 to-orange-600 dark:from-red-400 dark:to-orange-500"> 404 </span>
		</h1>
		<h2 class="text-2xl md:text-3xl font-bold mb-6 text-slate-800 dark:text-slate-200">Page Not Found</h2>
		<p class="text-lg text-slate-600 dark:text-slate-400 mb-12 max-w-md mx-auto">申し訳ありませんが、お探しのページは存在しないか、移動した可能性があります。</p>
		<div class="flex justify-center">
			<a href={BASE_DIR} class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-lg font-medium bg-primary-600 text-white hover:bg-primary-700 transition-colors shadow-lg">
				<HomeIcon class="w-5 h-5" />
				トップページに戻る
			</a>
		</div>
	</section>
</ErrorLayout>
