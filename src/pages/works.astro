---
import Layout from "../layouts/Layout.astro";
import WorkCard from "../components/WorkCard.astro";
import WorkModal from "../components/WorkModal.astro";
import { BASE_DIR } from "../config";

import { workItemsMap, worksData } from "../data/works";
import { createUrl } from "../scripts/libs/url-utils";
import { isImageMetadata } from "../types/work-item";

const personId = `${createUrl(BASE_DIR)}#person`;
const worksPageUrl = `${createUrl(BASE_DIR)}works/`;

const itemListSchema = {
	"@context": "https://schema.org",

	"@graph": [
		{
			"@type": "ItemList",
			"@id": `${worksPageUrl}#itemlist`,

			name: "Works",
			description: "制作物の一覧",

			numberOfItems: worksData.length,

			itemListOrder: "https://schema.org/ItemListOrderAscending",
			itemListElement: worksData.map((work, index) => ({
				"@type": "ListItem",

				position: index + 1,

				url: `${worksPageUrl}#work-card-${work.id}`,

				item: {
					"@type": work.ldJsonType ?? "CreativeWork",
					"@id": `${worksPageUrl}#work-${work.id}`,

					name: work.title,
					description: work.description,

					url: work.directLink == null ? work.githubLink : createUrl(work.directLink),

					image: isImageMetadata(work.imageUrl) ? createUrl(work.imageUrl.src) : work.imageUrl == null || work.imageUrl === "" ? undefined : createUrl(work.imageUrl),

					operatingSystem: work.ldJsonType === "WebApplication" || work.ldJsonType === "VideoGame" ? "Web" : undefined,
					applicationCategory: work.applicationCategory,
					gamePlatform: work.ldJsonType === "VideoGame" ? "Web Browser" : undefined,

					isAccessibleForFree: true,

					author: {
						"@id": personId,
					},
					creator: {
						"@id": personId,
					},

					inLanguage: "ja",
				},
			})),
		},
	],
};
---

<Layout title="Works" description="JavaScript/TypeScript を中心に用いた、個人開発の制作物一覧ページです。">
	<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

	<h1 class="text-4xl md:text-5xl font-extrabold mb-10 text-center">Works</h1>

	<script is:inline define:vars={{ items: workItemsMap }}>
		window.WORK_ITEMS = items;
	</script>

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
		{worksData.map((work) => <WorkCard {...work} />)}
	</div>

	<WorkModal />

	<script src="../scripts/work-modal.ts"></script>
</Layout>
