---
import "../styles/global.css";
import Header from "../components/Header.astro";
import FloatingHeader from "../components/FloatingHeader.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, BASE_DIR, AUTHOR, CLASS_AUTO_IMG_ALT } from "../config";
import { GoogleFontsOptimizer } from "astro-google-fonts-optimizer";
import { SEO } from "astro-seo";
import { pwaAssetsHead } from "virtual:pwa-assets/head";
import { pwaInfo } from "virtual:pwa-info";
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	description?: string;
}

const linkArr = [
	//
	...pwaAssetsHead.links.map((link: any) => ({ ...link })),
	{ rel: "sitemap", href: `${BASE_DIR}sitemap-index.xml` },
];
if (pwaInfo) {
	linkArr.push({ rel: "manifest", href: pwaInfo.webManifest.href });
}

const metaArr = [
	{ httpEquiv: "content-type", content: "text/html; charset=UTF-8" },
	{ httpEquiv: "X-UA-Compatible", content: "IE=edge" },
	{ httpEquiv: "content-language", content: "ja" },
	{ name: "viewport", content: "width=device-width, initial-scale=1.0" },
	{ name: "format-detection", content: "telephone=no, address=no, email=no" },
	{ name: "author", content: AUTHOR },
	{ name: "generator", content: Astro.generator },
	{ name: "mobile-web-app-capable", content: "yes" },
	{ name: "apple-mobile-web-app-capable", content: "yes" },
	{ name: "apple-mobile-web-app-status-bar-style", content: "black-translucent" },
	{ name: "apple-mobile-web-app-title", content: SITE_TITLE },
];
if (pwaAssetsHead.themeColor) {
	metaArr.push({ name: "theme-color", content: pwaAssetsHead.themeColor.content });
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
	<head prefix="website: https://ogp.me/ns/website#">
		<SEO
			charset="UTF-8"
			title={title}
			titleDefault="Page"
			titleTemplate={`%s | ${SITE_TITLE}`}
			description={description}
			openGraph={{
				basic: {
					title: title,
					type: "website",
					image: BASE_DIR + "maskable-icon-512x512.png",
				},
				optional: {
					description: description,
					locale: "ja_JP",
					siteName: SITE_TITLE,
				},
			}}
			twitter={{ creator: "@hi2ma_bu4", card: "summary" }}
			extend={{
				link: linkArr,
				meta: metaArr,
			}}
		/>

		<script type="module" is:inline>
			function updateTheme() {
				const theme = (() => {
					if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
						return localStorage.getItem("theme");
					}
					if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
						return "dark";
					}
					return "light";
				})();

				if (theme === "light") {
					document.documentElement.classList.remove("dark");
				} else {
					document.documentElement.classList.add("dark");
				}
				localStorage.setItem("theme", theme);
			}
			document.addEventListener("astro:after-swap", updateTheme);
			updateTheme();
		</script>
		<script type="module" is:inline define:vars={{ BASE_DIR, CLASS_AUTO_IMG_ALT }}>
			const ErrorImageUrl = `${BASE_DIR}no-image.svg`;
			const isCheckClassName = "bio-imgCheck";
			const isLoadClassName = "bio-imgLoad";
			const isErrClassName = "bio-imgLoadErr";

			function errLoad(e) {
				const img = e.target;
				img.onload = img.onerror = null;
				if (!(img instanceof HTMLImageElement)) return;

				// 無限ループ防止
				if (img.classList.contains(isLoadClassName) || img.classList.contains(isErrClassName)) return;
				img.classList.add(isCheckClassName);
				img.classList.add(isErrClassName);

				console.warn(`image load error: `, img.src);
				img.alt = `${img.alt ?? "説明なし"}(${img.src})`;
				img.src = ErrorImageUrl;

				if (img.classList.contains(CLASS_AUTO_IMG_ALT)) {
					wrapWithAltButton(img);
				}
			}

			function wrapWithAltButton(img) {
				// wrapper 生成
				const wrapper = document.createElement("div");
				wrapper.className = "img-wrapper";

				// img の親子入れ替え
				img.parentNode.insertBefore(wrapper, img);
				wrapper.appendChild(img);

				// alt ボタン追加
				const button = document.createElement("input");
				button.type = "button";
				button.className = "alt-button";
				button.value = "alt";
				wrapper.appendChild(button);

				const altText = img.alt;
				button.addEventListener("click", () => showAltPopup(wrapper, altText));
			}

			function showAltPopup(root, text) {
				const popup = document.createElement("div");
				popup.className = "alt-popup";
				popup.innerText = text;

				popup.addEventListener("click", () => popup.remove());
				root.appendChild(popup);
			}

			document.addEventListener("error", errLoad);

			let observer = new MutationObserver(updateImgLoadChecker);
			function updateImgLoadChecker() {
				const imgs = document.querySelectorAll(`img:not(.${isCheckClassName},.${isLoadClassName},.${isErrClassName})`);

				for (const img of imgs) {
					img.classList.add(isCheckClassName);
					img.onload = () => {
						img.onload = img.onerror = null;
						img.classList.add(isLoadClassName);
					};
					img.onerror = errLoad;
				}
			}
			document.addEventListener("astro:after-swap", () => {
				observer.disconnect();

				observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ["src"] });
				updateImgLoadChecker();
			});
			observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ["src"] });
			updateImgLoadChecker();
		</script>

		<GoogleAnalytics />
		<ClientRouter />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<GoogleFontsOptimizer url="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Noto+Sans+JP:wght@400;700&display=swap" />
	</head>
	<body class="min-h-screen flex flex-col">
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N2NZ68ZJ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<Header />
		<FloatingHeader />

		<main class="grow w-full max-w-5xl mx-auto px-4 py-8 md:px-8">
			<slot />
		</main>

		<Footer />

		<script src="../scripts/theme-toggle.ts"></script>
	</body>
</html>
