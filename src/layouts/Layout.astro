---
import "../styles/global.css";
import Header from "../components/Header.astro";
import FloatingHeader from "../components/FloatingHeader.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, BASE_DIR } from "../config.ts";
import { GoogleFontsOptimizer } from "astro-google-fonts-optimizer";
import { SEO } from "astro-seo";
import { pwaAssetsHead } from "virtual:pwa-assets/head";
import { pwaInfo } from "virtual:pwa-info";
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	description?: string;
}

const linkArr = [
	//
	...pwaAssetsHead.links.map((link: any) => ({ ...link })),
	{ rel: "sitemap", href: `${BASE_DIR}sitemap-index.xml` },
];
if (pwaInfo) {
	linkArr.push({ rel: "manifest", href: pwaInfo.webManifest.href });
}

const metaArr = [
	{ name: "viewport", content: "width=device-width" },
	{
		name: "generator",
		content: Astro.generator,
	},
];
if (pwaAssetsHead.themeColor) {
	metaArr.push({ name: "theme-color", content: pwaAssetsHead.themeColor.content });
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<SEO
			charset="UTF-8"
			title={title}
			titleDefault="Page"
			titleTemplate={`%s | ${SITE_TITLE}`}
			description={description}
			twitter={{ creator: "@hi2ma_bu4" }}
			extend={{
				link: linkArr,
				meta: metaArr,
			}}
		/>

		<script type="text/javascript" is:inline>
			const theme = (() => {
				if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
					return localStorage.getItem("theme");
				}
				if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					return "dark";
				}
				return "light";
			})();

			if (theme === "light") {
				document.documentElement.classList.remove("dark");
			} else {
				document.documentElement.classList.add("dark");
			}
			localStorage.setItem("theme", theme);
		</script>
		<script type="text/javascript" src="https://cdn.jsdelivr.net/gh/hi2ma-bu4/jasc@v1.15.3.10/jasc.js" is:inline></script>
		<script type="module" is:inline define:vars={{ BASE_DIR }}>
			const ErrorImageUrl = `${BASE_DIR}no-image.svg`;
			jasc.on("imageLoadError", (e) => {
				e.target.src = ErrorImageUrl;
			});
		</script>

		<ClientRouter />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<GoogleFontsOptimizer url="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Noto+Sans+JP:wght@400;700&display=swap" />
	</head>
	<body class="min-h-screen flex flex-col">
		<Header />
		<FloatingHeader />

		<main class="grow w-full max-w-5xl mx-auto px-4 py-8 md:px-8">
			<slot />
		</main>

		<Footer />

		<script src="../scripts/theme-toggle.ts"></script>
	</body>
</html>
