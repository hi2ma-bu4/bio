{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./.cache/tsbuildinfo.json",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": [
      "solid-js"
    ]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
